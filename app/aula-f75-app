#!/usr/bin/env python3
"""Launch the AULA F75 app: start the local backend and open it in an app window."""
import json, os, shutil, subprocess, sys, threading, urllib.request

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "aula-f75-app.json")


NATIVE = ("chromium", "chromium-browser", "google-chrome", "google-chrome-stable", "microsoft-edge",
          "microsoft-edge-stable", "brave", "brave-browser", "vivaldi", "vivaldi-stable")
FLATPAK = ("com.microsoft.Edge", "org.chromium.Chromium", "com.google.Chrome", "com.brave.Browser",
           "io.github.ungoogled_software.ungoogled_chromium", "com.vivaldi.Vivaldi")


def browser():
    """Command for a Chromium-based browser that supports --app windows, or None."""
    if os.environ.get("AULA_F75_BROWSER"):
        return os.environ["AULA_F75_BROWSER"].split()
    for b in NATIVE:
        if shutil.which(b):
            return [b]
    if shutil.which("flatpak"):
        for app_id in FLATPAK:
            if subprocess.run(["flatpak", "info", app_id], capture_output=True).returncode == 0:
                return ["flatpak", "run", app_id]
    return None


def open_window(url):
    b = browser()
    # Chromium-based browsers give a clean app window; anything else opens a normal tab.
    cmd = b + [f"--app={url}", "--start-maximized"] if b else ["xdg-open", url]
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def running_instance():
    try:
        info = json.load(open(STATE))
        os.kill(info["pid"], 0)
        req = urllib.request.Request(info["url"].split("/?")[0] + "/api/ping", headers={"X-Token": info["token"]})
        urllib.request.urlopen(req, timeout=2).read()
        return info["url"]
    except Exception:
        return None


def main():
    url = running_instance()
    if url:
        open_window(url)
        return
    import server
    srv = server.serve()
    port = srv.server_address[1]
    url = f"http://127.0.0.1:{port}/?t={server.TOKEN}"
    fd = os.open(STATE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump({"pid": os.getpid(), "url": url, "token": server.TOKEN}, f)
    server.LAST_PING[0] += 30          # grace period while the window starts
    threading.Thread(target=server.watchdog, args=(srv,), daemon=True).start()
    open_window(url)
    try:
        srv.serve_forever()
    finally:
        try:
            os.remove(STATE)
        except OSError:
            pass


if __name__ == "__main__":
    main()
